# E-Cubed Configuration
# Copy this to .env and fill in your values

SECRET_KEY=change-this-to-a-random-secret-key
DATABASE_URL=sqlite:///ecube.db

# Default admin credentials (change after first login)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@ecube.local

# --- Production hardening ---------------------------------------------
# Flask debug mode / auto-reloader. Never enable in production.
FLASK_DEBUG=false

# Require HTTPS for session cookies. Keep true behind ngrok/production.
# Set to false only when testing locally over plain http.
SESSION_COOKIE_SECURE=true

# Origins allowed to connect to the Socket.IO dashboard feed.
# "*" is fine for local dev; set to your real origin(s) in production,
# e.g. https://your-domain.com
SOCKETIO_CORS_ORIGINS=*
